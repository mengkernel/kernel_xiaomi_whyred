# Enable legacy ION
CONFIG_ION_LEGACY=y

# Enable QCACLD
CONFIG_QCA_CLD_WLAN=y

# Enable exFAT
CONFIG_EXFAT_FS=y

# enable LZ4 ZRAM
CONFIG_CRYPTO_LZ4=y

# Disable unused drivers
CONFIG_TOUCHSCREEN_ST=n
CONFIG_NFC_NQ=n
CONFIG_SCSI_UFSHCD=n
CONFIG_QCOM_QHEE_ENABLE_MEM_PROTECTION=n
CONFIG_MSM_CDSP_LOADER=n
CONFIG_QCOM_CDSP_RM=n
CONFIG_QCOM_CX_IPEAK=n
CONFIG_QTI_QMI_COOLING_DEVICE=n
CONFIG_WIL6210=n
CONFIG_MSM_RDBG=n
CONFIG_USB_GSPCA=n
CONFIG_DVB_MPQ=n

# Enable CONFIG_JUMP_LABEL
CONFIG_JUMP_LABEL=y

# disable CONFIG_RSEQ
CONFIG_RSEQ=n

# disable BALANCE_ANON_FILE_RECLAIM
CONFIG_BALANCE_ANON_FILE_RECLAIM=n

# enable CONFIG_INIT_STACK_ALL
CONFIG_INIT_STACK_ALL=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y

# Disable CONFIG_SECURITY_SMACK
CONFIG_SECURITY_SMACK=n
CONFIG_SECURITY_NETWORK=y

# Disable DM_CRYPT Kconfig
CONFIG_DM_CRYPT=n

# Enable UNICODE
CONFIG_UNICODE=y

# Disable F2FS I/O Stats
CONFIG_F2FS_IOSTAT=n

# Disable AUDIT
CONFIG_AUDIT=n

# Enable CONFIG_INITRAMFS_IGNORE_SKIP_FLAG
CONFIG_INITRAMFS_IGNORE_SKIP_FLAG=y

# Enable sdFAT
CONFIG_SDFAT_SUPPORT_DIR_SYNC=y
CONFIG_SDFAT_CHECK_RO_ATTR=y
CONFIG_SDFAT_DEBUG=n

# Append DTB into kernel image
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y

# Build into kernel
CONFIG_MTD=y
CONFIG_MTD_OF_PARTS=y
CONFIG_RC_CORE=y
CONFIG_RC_MAP=y
CONFIG_VIDEO_IR_I2C=y
CONFIG_LCD_CLASS_DEVICE=y
CONFIG_MMC_TEST=y
CONFIG_EFIVAR_FS=y

# Enable fingerprint driver
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FPC_FINGERPRINT=y
CONFIG_GOODIX_FINGERPRINT=y

# Enable KernelSU Next
CONFIG_KSU=y

# Enable userspace CNTVCT_EL0 access for vDSO
CONFIG_ARM_ARCH_TIMER_VCT_ACCESS=y

# Don't compile out kernel headers
CONFIG_IKHEADERS=n

# Disable vm event counters
CONFIG_VM_EVENT_COUNTERS=n

# Enable pstore and mtd oops
CONFIG_CMDLINE="cgroup_disable=pressure ramoops_memreserve=4M"
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_DEFLATE_COMPRESS=n
# duplicate CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_OOPS=y
CONFIG_MTD_BLOCK2MTD=y
CONFIG_PANIC_ON_OOPS=n

# Disable MSM 11AD chip support
CONFIG_MSM_11AD=n

# Disable Modules signature
CONFIG_MODULE_SIG=n

# Disable PASR
CONFIG_MEMORY_HOTPLUG=n
CONFIG_QCOM_MEM_OFFLINE=n

# Disable media ancillary drivers autoselecting support
CONFIG_MEDIA_SUBDRV_AUTOSELECT=n
# Keep I2C
CONFIG_I2C=y

# Disable Tablets input support
CONFIG_INPUT_TABLET=n
# Keep CONFIG_USB
CONFIG_USB=y

# Disable Digital TV support
CONFIG_MEDIA_DIGITAL_TV_SUPPORT=n

# Disable Media USB Adapters
CONFIG_MEDIA_USB_SUPPORT=n

# Disable OKL4 Hypervisor guest support
CONFIG_OKL4_GUEST=n

# Disable unused WLAN driver
CONFIG_WLAN_VENDOR_ADMTEK=n
CONFIG_WLAN_VENDOR_ATH=n
CONFIG_WLAN_VENDOR_ATMEL=n
CONFIG_WLAN_VENDOR_BROADCOM=n
CONFIG_WLAN_VENDOR_CISCO=n
CONFIG_WLAN_VENDOR_INTEL=n
CONFIG_WLAN_VENDOR_INTERSIL=n
CONFIG_WLAN_VENDOR_MARVELL=n
CONFIG_WLAN_VENDOR_MEDIATEK=n
CONFIG_WLAN_VENDOR_RALINK=n
CONFIG_WLAN_VENDOR_REALTEK=n
CONFIG_WLAN_VENDOR_RSI=n
CONFIG_WLAN_VENDOR_ST=n
CONFIG_WLAN_VENDOR_TI=n
CONFIG_WLAN_VENDOR_ZYDAS=n
CONFIG_WLAN_VENDOR_QUANTENNA=n

# Disable unused ethernet driver
CONFIG_NET_VENDOR_3COM=n
CONFIG_NET_VENDOR_ADAPTEC=n
CONFIG_NET_VENDOR_AGERE=n
CONFIG_NET_VENDOR_ALACRITECH=n
CONFIG_NET_VENDOR_ALTEON=n
CONFIG_NET_VENDOR_AMAZON=n
CONFIG_NET_VENDOR_AMD=n
CONFIG_NET_VENDOR_AQUANTIA=n
CONFIG_NET_VENDOR_ARC=n
CONFIG_NET_VENDOR_ATHEROS=n
CONFIG_NET_VENDOR_AURORA=n
CONFIG_NET_VENDOR_BROADCOM=n
CONFIG_NET_VENDOR_BROCADE=n
CONFIG_NET_VENDOR_CADENCE=n
CONFIG_NET_VENDOR_CAVIUM=n
CONFIG_NET_VENDOR_CHELSIO=n
CONFIG_NET_VENDOR_CISCO=n
CONFIG_NET_VENDOR_CORTINA=n
CONFIG_NET_VENDOR_DEC=n
CONFIG_NET_VENDOR_DLINK=n
CONFIG_NET_VENDOR_EMULEX=n
CONFIG_NET_VENDOR_EZCHIP=n
CONFIG_NET_VENDOR_HISILICON=n
CONFIG_NET_VENDOR_HP=n
CONFIG_NET_VENDOR_HUAWEI=n
CONFIG_NET_VENDOR_I825XX=n
CONFIG_NET_VENDOR_INTEL=n
CONFIG_NET_VENDOR_MARVELL=n
CONFIG_NET_VENDOR_MELLANOX=n
CONFIG_NET_VENDOR_MICREL=n
CONFIG_NET_VENDOR_MICROCHIP=n
CONFIG_NET_VENDOR_MICROSEMI=n
CONFIG_NET_VENDOR_MYRI=n
CONFIG_NET_VENDOR_NATSEMI=n
CONFIG_NET_VENDOR_NETERION=n
CONFIG_NET_VENDOR_NETRONOME=n
CONFIG_NET_VENDOR_NI=n
CONFIG_NET_VENDOR_8390=n
CONFIG_NET_VENDOR_NVIDIA=n
CONFIG_NET_VENDOR_OKI=n
CONFIG_NET_VENDOR_PACKET_ENGINES=n
CONFIG_NET_VENDOR_QLOGIC=n
CONFIG_NET_VENDOR_RDC=n
CONFIG_NET_VENDOR_REALTEK=n
CONFIG_NET_VENDOR_RENESAS=n
CONFIG_NET_VENDOR_ROCKER=n
CONFIG_NET_VENDOR_SAMSUNG=n
CONFIG_NET_VENDOR_SEEQ=n
CONFIG_NET_VENDOR_SOLARFLARE=n
CONFIG_NET_VENDOR_SILAN=n
CONFIG_NET_VENDOR_SIS=n
CONFIG_NET_VENDOR_SMSC=n
CONFIG_NET_VENDOR_SOCIONEXT=n
CONFIG_NET_VENDOR_STMICRO=n
CONFIG_NET_VENDOR_SUN=n
CONFIG_NET_VENDOR_SYNOPSYS=n
CONFIG_NET_VENDOR_TEHUTI=n
CONFIG_NET_VENDOR_TI=n
CONFIG_NET_VENDOR_VIA=n
CONFIG_NET_VENDOR_WIZNET=n

# Enable XFRM_MIGRATE
CONFIG_XFRM_MIGRATE=y
